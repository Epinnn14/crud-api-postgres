# Copy to .env (git-ignored). docker compose reads these automatically.
POSTGRES_USER=tasks
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tasks

# Used when you run the API on your machine (not in Docker) against the Postgres container:
DATABASE_URL=postgresql://tasks:change-me@localhost:5432/tasks
# Remove DATABASE_URL to fall back to the A2 SQLite file (tasks.db).
